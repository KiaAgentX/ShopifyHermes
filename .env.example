TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-bot-token
OWNER_CHAT_ID=your-telegram-user-id

# --- Provider 1: numes.ai (OpenAI-compatible) ---
OPENAI_BASE_URL=https://api.numes.ai/api/v1
OPENAI_API_KEY=sk-your-key
# fallback order (comma separated)
MODELS=model-a,model-b,model-c
# multi-key rotation (comma separated) — brain switches on 402/429
NUMES_API_KEYS=sk-key-1,sk-key-2

# --- Provider 2: OpenRouter (free models, optional) ---
# get a key: https://openrouter.ai/keys  · free model ids end with ":free"
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODELS=model-x:free,model-y:free
